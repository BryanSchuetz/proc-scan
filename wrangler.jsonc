{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "procurement-opportunity-registry",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "TEAM_DOMAIN": "https://divine-leaf-d5e5.cloudflareaccess.com",
    "POLICY_AUD": "500f0d037777ed1f8fc600c1ce9947621d8476a9a437079432df26bb5d267437"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "procurement-opportunities",
      "database_id": "2d9959f3-4a6f-4d23-b9d9-0334f67a715d",
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    {
      "name": "procurement-scan",
      "binding": "SCAN_WORKFLOW",
      "class_name": "ScanWorkflow",
      "schedules": [
        "0 10 * * *",
        "0 11 * * *",
        "0 22 * * *",
        "0 23 * * *"
      ]
    }
  ]
}
