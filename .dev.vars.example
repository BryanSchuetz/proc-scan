# Cloudflare Access is bypassed only for loopback requests. These values are
# required for any shared preview or production hostname.
TEAM_DOMAIN=https://your-team.cloudflareaccess.com
POLICY_AUD=your-access-application-audience

# Source credentials (add only when the matching adapter is enabled).
SAM_API_KEY=

# Campaign Monitor transactional digest delivery. Leave all three required
# values empty to disable delivery locally. CAMP_MONTR_CLIENT_ID is only
# needed with an account-level API key.
CAMP_MONTR_KEY=
CAMP_MONTR_CLIENT_ID=
DIGEST_FROM=
DIGEST_REPLY_TO=
# One address or multiple comma-separated addresses.
DIGEST_RECIPIENT=
REGISTRY_URL=
